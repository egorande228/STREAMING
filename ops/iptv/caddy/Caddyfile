livekinglive.win {
  encode gzip
  root * /srv/livekinglive-player
  try_files {path} {path}/index.html /index.html
  file_server
}

hls.livekinglive.win {
  encode gzip

  handle_path /lb/* {
    reverse_proxy 127.0.0.1:8090
  }

  handle /live/* {
    # Caddy runs in host networking on the origin VPS. Route /live through
    # the local HLS cache so a remote edge outage cannot make the main HLS
    # hostname return 503 while MediaMTX is healthy.
    reverse_proxy 127.0.0.1:80
  }

  handle {
    reverse_proxy 127.0.0.1:80
  }
}
