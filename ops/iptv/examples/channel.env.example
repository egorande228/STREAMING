# Copy to /etc/kinglive/iptv/channels/<slug>.env and chmod 600.
# Do not commit real donor URLs or tokens.

SOURCE_URL="https://example.invalid/channel/index.m3u8?token=REPLACE_ME"
STREAM_KEY="fox-sport-1-hd"

# Sharavoz was observed to behave better when FFmpeg looks like VLC.
USER_AGENT="VLC/3.0.18 LibVLC/3.0.18"

# Optional donor headers. Leave empty unless the donor requires them.
REFERER=""
ORIGIN=""

# RTMP target inside the same VPS. MediaMTX listens on 127.0.0.1:1935.
RTMP_URL="rtmp://127.0.0.1:1935/live/${STREAM_KEY}"

# Keep below the IPTV device/session limit. Default is 2.
MAX_RESTREAMS="2"

# Legacy variable names are also supported by /usr/local/bin/kinglive-restream:
# RESTREAM_INPUT_URL="$SOURCE_URL"
# RESTREAM_RTMP_URL="$RTMP_URL"
