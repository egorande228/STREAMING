#!/usr/bin/env bash
set -euo pipefail

slug="${1:-}"
if [[ -z "$slug" || "$slug" == *"/"* || "$slug" == *".."* ]]; then
  echo "Usage: kinglive-restream <channel-slug>" >&2
  exit 64
fi

env_file="/etc/kinglive/iptv/channels/${slug}.env"
legacy_env_file="/etc/kinglive/restreams/${slug}.env"
if [[ ! -r "$env_file" && -r "$legacy_env_file" ]]; then
  env_file="$legacy_env_file"
fi
if [[ ! -r "$env_file" ]]; then
  echo "Missing readable channel env: $env_file or $legacy_env_file" >&2
  exit 66
fi

# shellcheck disable=SC1090
source "$env_file"

SOURCE_URL="${SOURCE_URL:-${RESTREAM_INPUT_URL:-}}"
: "${SOURCE_URL:?SOURCE_URL or RESTREAM_INPUT_URL is required}"
STREAM_KEY="${STREAM_KEY:-$slug}"
USER_AGENT="${USER_AGENT:-VLC/3.0.18 LibVLC/3.0.18}"
RTMP_URL="${RTMP_URL:-${RESTREAM_RTMP_URL:-rtmp://127.0.0.1:1935/live/${STREAM_KEY}}}"
REFERER="${REFERER:-}"
ORIGIN="${ORIGIN:-}"
MAX_RESTREAMS="${MAX_RESTREAMS:-3}"
TRANSCODE_PROFILE="${TRANSCODE_PROFILE:-${RESTREAM_TRANSCODE_PROFILE:-auto}}"
OVERLAY_ENABLED="${OVERLAY_ENABLED:-${RESTREAM_OVERLAY_ENABLED:-false}}"
OVERLAY_IMAGE="${OVERLAY_IMAGE:-${RESTREAM_OVERLAY_IMAGE:-}}"
OVERLAY_DIR="${OVERLAY_DIR:-${RESTREAM_OVERLAY_DIR:-/opt/kinglive/overlays}}"
OVERLAY_POSITION="${OVERLAY_POSITION:-${RESTREAM_OVERLAY_POSITION:-top-right}}"
OVERLAY_WIDTH="${OVERLAY_WIDTH:-${RESTREAM_OVERLAY_WIDTH:-420}}"
OVERLAY_MARGIN="${OVERLAY_MARGIN:-${RESTREAM_OVERLAY_MARGIN:-24}}"
OVERLAY_X_PERCENT="${OVERLAY_X_PERCENT:-${RESTREAM_OVERLAY_X_PERCENT:-}}"
OVERLAY_Y_PERCENT="${OVERLAY_Y_PERCENT:-${RESTREAM_OVERLAY_Y_PERCENT:-}}"
OVERLAY_COUNT="${OVERLAY_COUNT:-${RESTREAM_OVERLAY_COUNT:-}}"

if ! [[ "$MAX_RESTREAMS" =~ ^[0-9]+$ ]] || [[ "$MAX_RESTREAMS" -lt 1 || "$MAX_RESTREAMS" -gt 4 ]]; then
  echo "MAX_RESTREAMS must be between 1 and 4" >&2
  exit 65
fi

active_restreams="$(
  { pgrep -af 'ffmpeg .*rtmp://127[.]0[.]0[.]1:1935/live/' || true; } \
    | awk -v current="rtmp://127.0.0.1:1935/live/${STREAM_KEY}" '$0 !~ current "$" { count++ } END { print count + 0 }'
)"
if [[ "${active_restreams:-0}" -ge "$MAX_RESTREAMS" ]]; then
  echo "Refusing to start ${slug}: ${active_restreams} restream(s) already active, limit is ${MAX_RESTREAMS}" >&2
  exit 75
fi

headers=()
if [[ -n "$REFERER" || -n "$ORIGIN" ]]; then
  header_blob=""
  [[ -n "$REFERER" ]] && header_blob+="Referer: ${REFERER}"$'\r\n'
  [[ -n "$ORIGIN" ]] && header_blob+="Origin: ${ORIGIN}"$'\r\n'
  headers=(-headers "$header_blob")
fi

reconnect_at_eof=(-reconnect_at_eof 1)
extra_inputs=()
map_args=(-map 0:v:0? -map 0:a:0?)
filter_args=()
audio_filter_args=()
codec_args=(-c copy)
video_filter=""
video_encoder_args=()
audio_encoder_args=()
if [[ "$SOURCE_URL" =~ \.m3u8($|\?) ]]; then
  reconnect_at_eof=()
fi
if [[ "$SOURCE_URL" == *".hls.gd/"* ]]; then
  audio_filter_args=(-af "aresample=async=1:first_pts=0")
  codec_args=(-c:v copy -c:a aac -b:a 128k)
  if [[ "$TRANSCODE_PROFILE" == "auto" ]]; then
    probe_codec="$(
      ffprobe \
        -v error \
        -user_agent "$USER_AGENT" \
        "${headers[@]}" \
        -select_streams v:0 \
        -show_entries stream=codec_name \
        -of default=noprint_wrappers=1:nokey=1 \
        "$SOURCE_URL" \
        2>/dev/null \
        | head -n 1
    )"
    if [[ "$probe_codec" == "hevc" || "$probe_codec" == "h265" ]]; then
      TRANSCODE_PROFILE="h264_720p25"
    fi
  fi
fi

overlay_enabled="false"
if [[ "${OVERLAY_ENABLED,,}" == "true" || "$OVERLAY_ENABLED" == "1" || "${OVERLAY_ENABLED,,}" == "yes" ]]; then
  overlay_enabled="true"
fi

if [[ "$overlay_enabled" == "true" ]]; then
  if [[ -z "$OVERLAY_COUNT" ]]; then
    OVERLAY_COUNT=1
  fi
  if ! [[ "$OVERLAY_COUNT" =~ ^[0-9]+$ ]] || [[ "$OVERLAY_COUNT" -lt 1 || "$OVERLAY_COUNT" -gt 3 ]]; then
    echo "RESTREAM_OVERLAY_COUNT must be between 1 and 3" >&2
    exit 65
  fi
  overlay_paths=()
  overlay_positions=()
  overlay_widths=()
  overlay_margins=()
  overlay_x_percents=()
  overlay_y_percents=()
  for ((i = 1; i <= OVERLAY_COUNT; i++)); do
    image_var="RESTREAM_OVERLAY_${i}_IMAGE"
    position_var="RESTREAM_OVERLAY_${i}_POSITION"
    width_var="RESTREAM_OVERLAY_${i}_WIDTH"
    margin_var="RESTREAM_OVERLAY_${i}_MARGIN"
    x_var="RESTREAM_OVERLAY_${i}_X_PERCENT"
    y_var="RESTREAM_OVERLAY_${i}_Y_PERCENT"
    image="${!image_var:-}"
    position="${!position_var:-top-right}"
    width="${!width_var:-420}"
    margin="${!margin_var:-24}"
    x_percent="${!x_var:-}"
    y_percent="${!y_var:-}"
    if [[ "$i" -eq 1 && -z "$image" ]]; then
      image="$OVERLAY_IMAGE"
      position="$OVERLAY_POSITION"
      width="$OVERLAY_WIDTH"
      margin="$OVERLAY_MARGIN"
      x_percent="$OVERLAY_X_PERCENT"
      y_percent="$OVERLAY_Y_PERCENT"
    fi
    if [[ ! "$image" =~ ^[A-Za-z0-9._-]+\.png$ ]]; then
      echo "Invalid overlay image: ${image}" >&2
      exit 65
    fi
    overlay_path="${OVERLAY_DIR%/}/${image}"
    if [[ ! -r "$overlay_path" ]]; then
      echo "Missing readable overlay image: ${overlay_path}" >&2
      exit 66
    fi
    if ! [[ "$width" =~ ^[0-9]+$ ]] || [[ "$width" -lt 80 || "$width" -gt 1000 ]]; then
      echo "RESTREAM_OVERLAY_${i}_WIDTH must be between 80 and 1000" >&2
      exit 65
    fi
    if ! [[ "$margin" =~ ^[0-9]+$ ]] || [[ "$margin" -gt 200 ]]; then
      echo "RESTREAM_OVERLAY_${i}_MARGIN must be between 0 and 200" >&2
      exit 65
    fi
    if [[ -n "$x_percent" || -n "$y_percent" ]]; then
      if ! [[ "$x_percent" =~ ^[0-9]+$ ]] || [[ "$x_percent" -gt 100 ]]; then
        echo "RESTREAM_OVERLAY_${i}_X_PERCENT must be between 0 and 100" >&2
        exit 65
      fi
      if ! [[ "$y_percent" =~ ^[0-9]+$ ]] || [[ "$y_percent" -gt 100 ]]; then
        echo "RESTREAM_OVERLAY_${i}_Y_PERCENT must be between 0 and 100" >&2
        exit 65
      fi
    fi
    overlay_paths+=("$overlay_path")
    overlay_positions+=("$position")
    overlay_widths+=("$width")
    overlay_margins+=("$margin")
    overlay_x_percents+=("$x_percent")
    overlay_y_percents+=("$y_percent")
  done
  if [[ ! "$TRANSCODE_PROFILE" =~ ^h264_ ]]; then
    TRANSCODE_PROFILE="h264_720p25"
  fi
fi

case "$TRANSCODE_PROFILE" in
  h264_720p25)
    video_filter="scale=-2:720,fps=25"
    video_encoder_args=(-c:v libx264 -preset veryfast -tune zerolatency -pix_fmt yuv420p -g 50 -keyint_min 50 -sc_threshold 0)
    audio_filter_args=(-af "aresample=async=1:first_pts=0")
    audio_encoder_args=(-c:a aac -b:a 128k)
    ;;
  h264_1080p25)
    video_filter="scale=-2:1080,fps=25"
    video_encoder_args=(-c:v libx264 -preset veryfast -tune zerolatency -pix_fmt yuv420p -g 50 -keyint_min 50 -sc_threshold 0 -maxrate 6500k -bufsize 13000k)
    audio_filter_args=(-af "aresample=async=1:first_pts=0")
    audio_encoder_args=(-c:a aac -b:a 128k)
    ;;
  h264_1080p50)
    video_filter="scale=-2:1080,fps=50"
    video_encoder_args=(-c:v libx264 -preset veryfast -tune zerolatency -pix_fmt yuv420p -g 100 -keyint_min 100 -sc_threshold 0 -maxrate 8500k -bufsize 17000k)
    audio_filter_args=(-af "aresample=async=1:first_pts=0")
    audio_encoder_args=(-c:a aac -b:a 128k)
    ;;
esac

if [[ "$overlay_enabled" == "true" ]]; then
  filter_complex="[0:v]${video_filter}[v0]"
  for ((i = 0; i < OVERLAY_COUNT; i++)); do
    input_index=$((i + 1))
    input_label="v${i}"
    output_label="v$((i + 1))"
    margin="${overlay_margins[$i]}"
    if [[ -n "${overlay_x_percents[$i]}" && -n "${overlay_y_percents[$i]}" ]]; then
      overlay_x="(W-w)*${overlay_x_percents[$i]}/100"
      overlay_y="(H-h)*${overlay_y_percents[$i]}/100"
    else
      case "${overlay_positions[$i]}" in
        top-left) overlay_x="$margin"; overlay_y="$margin" ;;
        top-center) overlay_x="(W-w)/2"; overlay_y="$margin" ;;
        top-right) overlay_x="W-w-${margin}"; overlay_y="$margin" ;;
        center) overlay_x="(W-w)/2"; overlay_y="(H-h)/2" ;;
        bottom-left) overlay_x="$margin"; overlay_y="H-h-${margin}" ;;
        bottom-center) overlay_x="(W-w)/2"; overlay_y="H-h-${margin}" ;;
        bottom-right) overlay_x="W-w-${margin}"; overlay_y="H-h-${margin}" ;;
        *)
          echo "Invalid overlay position: ${overlay_positions[$i]}" >&2
          exit 65
          ;;
      esac
    fi
    extra_inputs+=(-loop 1 -i "${overlay_paths[$i]}")
    filter_complex+=";[${input_index}:v]scale=${overlay_widths[$i]}:-1[ov${i}];[${input_label}][ov${i}]overlay=${overlay_x}:${overlay_y}:format=auto[${output_label}]"
  done
  filter_args=(-filter_complex "$filter_complex")
  map_args=(-map "[v${OVERLAY_COUNT}]" -map 0:a:0?)
  codec_args=("${video_encoder_args[@]}" "${audio_encoder_args[@]}")
elif [[ -n "$video_filter" ]]; then
  filter_args=(-vf "$video_filter")
  codec_args=("${video_encoder_args[@]}" "${audio_encoder_args[@]}")
fi

exec ffmpeg \
  -hide_banner \
  -loglevel info \
  -nostdin \
  -reconnect 1 \
  -reconnect_streamed 1 \
  "${reconnect_at_eof[@]}" \
  -reconnect_on_network_error 1 \
  -reconnect_on_http_error 4xx,5xx \
  -reconnect_delay_max 5 \
  -rw_timeout 15000000 \
  -user_agent "$USER_AGENT" \
  "${headers[@]}" \
  -i "$SOURCE_URL" \
  "${extra_inputs[@]}" \
  "${map_args[@]}" \
  "${filter_args[@]}" \
  "${audio_filter_args[@]}" \
  "${codec_args[@]}" \
  -f flv \
  "$RTMP_URL"
