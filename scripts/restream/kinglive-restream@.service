[Unit]
Description=KingLive IPTV restream %i
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/kinglive/restreams/%i.env
Restart=always
RestartSec=5
ExecStart=/usr/bin/ffmpeg -hide_banner -loglevel warning -reconnect 1 -reconnect_streamed 1 -reconnect_delay_max 10 -rw_timeout 15000000 -i ${RESTREAM_INPUT_URL} -map 0:v:0? -map 0:a:0? -c copy -f flv ${RESTREAM_RTMP_URL}

[Install]
WantedBy=multi-user.target
